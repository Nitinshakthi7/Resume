# GEMINI_API_KEY: required for the /api/chat chatbot endpoint (server/geminiClient.ts).
# Get a free key at https://aistudio.google.com/apikey — no billing account needed.
#
# Local dev: copy this file to .env (gitignored) and fill in your key; `vercel dev`
# loads it automatically. Production: set it in the Vercel dashboard under
# Project Settings -> Environment Variables (Production, and Preview if you want
# preview deployments to also answer chat requests) — Vercel injects it into the
# serverless function at runtime, it's never bundled into client code.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
